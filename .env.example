# ===== 阿里云百炼（DashScope）=====
# API Key 获取：https://bailian.console.aliyun.com/ → API-KEY 管理
# 复制本文件为 .env 后，把下面的占位符替换成你自己的 Key。
DASHSCOPE_API_KEY=sk-xxx

# 百炼的 Anthropic 兼容端点。
# 课程代码继续使用 anthropic SDK 的 Messages API，只是把 base_url 指向百炼。
# SDK 会自动在 base_url 后拼接 /v1/messages。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic

# 模型 ID
MODEL_ID=deepseek-v4.1-flash-1017

# 可选：s17 Goal 判断器使用的模型（默认复用 MODEL_ID）
# GOAL_EVALUATOR_MODEL_ID=deepseek-v4.1-flash-1017

# ===== 说明 =====
# 1. 本项目统一使用 DASHSCOPE_*，不需要 ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL。
# 2. 如果百炼控制台显示的模型 ID 不同，以控制台为准。
# 3. .env 已被 .gitignore 忽略，不会提交到 git。